PUBLIC_API_ORIGIN=http://127.0.0.1:3001

# ── Local-dev-only auto-login (optional) ─────────────────────────────────────
# When set, /assets/add and every other dashboard route skip the login form
# entirely under `npm run dev` and sign in as the account below instead.
# Safe by construction: the server route behind this reads SvelteKit's own
# `dev` build-time flag, which is only ever true under the Vite dev server —
# it cannot be true in a deployed build no matter what env vars are present
# there, so leaving these set (or even committed) creates no exposure outside
# a local `vite dev` process.
# AUTO_LOGIN_DEV=true
# AUTO_LOGIN_DEV_EMAIL=<matches oracle-api's BOOTSTRAP_ADMIN_EMAIL>
# AUTO_LOGIN_DEV_PASSWORD=<matches oracle-api's BOOTSTRAP_ADMIN_PASSWORD>
