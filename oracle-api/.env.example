# ── Local development ────────────────────────────────────────────────────────
# 1. docker compose -f ../docker-compose.local.yml up -d
# 2. Uncomment the two lines below (127.0.0.1, not localhost — Docker's port
#    publish is IPv4-only, and Node/Prisma resolving "localhost" to ::1 will
#    connect-refuse forever).
# 3. npm run db:push (fresh local db) then npm run db:seed && npm run db:bootstrap-admin
# DATABASE_URL=postgresql://oracle_dev:oracle_dev_local_only@127.0.0.1:55432/oracle_inventory_dev
# DIRECT_URL=postgresql://oracle_dev:oracle_dev_local_only@127.0.0.1:55432/oracle_inventory_dev

DATABASE_URL=postgresql://runtime_user:password@host:5432/postgres?sslmode=require
# Used only for migrations and backup/restore tooling; never expose to Vercel.
DIRECT_URL=postgresql://migration_user:password@host:5432/postgres?sslmode=require
JWT_SECRET=replace_with_a_high_entropy_secret
PORT=3001
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
MAINTENANCE_SCHEDULER_ENABLED=false
EMAIL_FROM=Oracle Inventory <onboarding@resend.dev>
RESEND_API_KEY=re_replace_with_provider_secret

# One-time local/CI bootstrap only. Never save these values in a hosted runtime.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=use_a_unique_16_plus_character_temporary_password
# BOOTSTRAP_ADMIN_NAME=Initial Administrator

# ── Network device credentials (optional) ────────────────────────────────────
# AES-256-GCM key used to encrypt switch/AP/router usernames, passwords, SNMP
# communities, VPN pre-shared keys, Wi-Fi passwords, API keys, and recovery
# codes recorded on the Network page. 32 raw bytes as 64 hex chars, e.g.
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset to disable saving/revealing device credentials entirely.
NETWORK_CREDENTIAL_KEY=

# ── Zoho Directory integration (optional) ────────────────────────────────────
# Enables employee enrichment during bulk import. Leave blank to disable.
# OAuth client credentials from Zoho API Console → Self Client or Server-based App.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# Override base URLs for region-specific Zoho accounts (e.g. .eu, .in, .com.au)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_DIRECTORY_URL=https://directory.zoho.com
