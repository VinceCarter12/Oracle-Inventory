DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=change_this_to_a_random_32_char_string
PORT=3001
CORS_ORIGIN=https://yourdomain.com

# ── Zoho Directory integration (optional) ────────────────────────────────────
# Enables employee enrichment during bulk import. Leave blank to disable.
# OAuth client credentials from Zoho API Console → Self Client or Server-based App.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# Override base URLs for region-specific Zoho accounts (e.g. .eu, .in, .com.au)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_DIRECTORY_URL=https://directory.zoho.com
