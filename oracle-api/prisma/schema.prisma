generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       SystemUser[]
}

model Permission {
  id            String           @id @default(cuid())
  key           String           @unique
  description   String?
  roles         RolePermission[]
  userOverrides UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  granted      Boolean    @default(true)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model SystemUser {
  id                  String                @id @default(cuid())
  name                String
  email               String                @unique
  password            String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  phone               String?
  position            String?
  roleId              String?
  status              UserStatus            @default(active)
  mustChangePassword  Boolean               @default(false)
  branchId            String?
  activityLogs        ActivityLog[]
  mappingPresets      ColumnMappingPreset[]
  importHistory       ImportHistory[]
  scanRooms           ScanRoom[]
  submittedHwScans    HardwareScan[]        @relation("HardwareScanSubmitter")
  reviewedHwScans     HardwareScan[]        @relation("HardwareScanReviewer")
  branch              Branch?               @relation(fields: [branchId], references: [id])
  role                Role?                 @relation(fields: [roleId], references: [id])
  permissionOverrides UserPermission[]
  intakeDrafts        ComputerIntakeDraft[]
  reviewedObservations InventoryObservation[] @relation("InventoryObservationReviewer")
  rolloutChanges       FeatureRollout[]       @relation("FeatureRolloutUpdater")
  rolloutBranchChanges FeatureRolloutBranch[] @relation("FeatureRolloutBranchUpdater")
  stockMovementsPerformed StockMovement[]     @relation("StockMovementPerformedBy")
  stockMovementsApproved  StockMovement[]     @relation("StockMovementApprovedBy")
  stockCountsStarted      StockCountSession[] @relation("StockCountStartedBy")
  stockCountsApproved     StockCountSession[] @relation("StockCountApprovedBy")
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  purpose   String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

model ActivityLog {
  id        String      @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime    @default(now())
  user      SystemUser? @relation(fields: [userId], references: [id])
}

model Branch {
  id         String       @id @default(cuid())
  name       String
  address    String?
  latitude   Float?
  longitude  Float?
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  assets     Asset[]
  employees  Employee[]
  users      SystemUser[]
  intakeDrafts ComputerIntakeDraft[]
  featureOverrides FeatureRolloutBranch[]
  stockLocations StockLocation[]
}

model FeatureRollout {
  id              String                 @id @default(cuid())
  key             String                 @unique
  enabledGlobally Boolean                @default(false)
  status          RolloutStatus          @default(disabled)
  minimumRole     String?
  configVersion   Int                    @default(1)
  updatedById     String?
  updatedAt       DateTime               @updatedAt
  createdAt       DateTime               @default(now())
  updatedBy       SystemUser?            @relation("FeatureRolloutUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  branchOverrides FeatureRolloutBranch[]
}

model FeatureRolloutBranch {
  id          String         @id @default(cuid())
  featureKey  String
  branchId    String
  enabled     Boolean
  reason      String?
  updatedById String?
  updatedAt   DateTime       @updatedAt
  createdAt   DateTime       @default(now())
  feature     FeatureRollout @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  updatedBy   SystemUser?    @relation("FeatureRolloutBranchUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([featureKey, branchId])
  @@index([branchId])
}

model Department {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  employees Employee[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  assets    Asset[]
}

model Employee {
  id           String            @id @default(cuid())
  name         String
  email        String?           @unique
  phone        String?
  employeeId   String?           @unique
  departmentId String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  branchId     String?
  source       String            @default("manual")
  position     String?
  assignments  AssetAssignment[]
  branch       Branch?           @relation(fields: [branchId], references: [id])
  department   Department?       @relation(fields: [departmentId], references: [id])
  movementLogs MovementLog[]
  stockMovements StockMovement[]
}

model Asset {
  id                  String            @id @default(cuid())
  name                String
  serialNumber        String?
  categoryId          String?
  condition           AssetCondition    @default(usable)
  ownership           OwnershipType     @default(company)
  description         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  nextMaintenanceDate DateTime?
  warrantyExpiry      DateTime?
  assetTag            String?
  branchId            String?
  computerName        String?
  imeiNumber          String?
  importId            String?
  macAddress          String?
  metadata            Json?
  propertyTag         String?
  lostAt              DateTime?
  lostStolenNotes     String?
  status              AssetStatus       @default(active)
  notifiedDue         DateTime?
  notifiedReminder    DateTime?
  purchaseDate        DateTime?
  branch              Branch?           @relation(fields: [branchId], references: [id])
  category            Category?         @relation(fields: [categoryId], references: [id])
  importHistory       ImportHistory?    @relation(fields: [importId], references: [id])
  assignments         AssetAssignment[]
  movementLogs        MovementLog[]
  hardwareScans       HardwareScan[]
  deviceProfile       DeviceProfile?
  components          AssetComponent[]
  observations        InventoryObservation[]
  stockMovements      StockMovement[]
  cameraProfile       CameraProfile?
  recorderProfile     RecorderProfile?
  secretReferences    AssetSecretReference[] @relation("AssetSecretReferences")
}

model DeviceProfile {
  id               String     @id @default(cuid())
  assetId          String     @unique
  deviceType       DeviceType @default(computer)
  brand            String?
  model            String?
  deviceSerial     String?
  processor        String?
  motherboard      String?
  operatingSystem  String?
  osVersion        String?
  osInstallDate    DateTime?
  source           String     @default("manual")
  sourceObservedAt DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  asset            Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  components       AssetComponent[]

  @@index([deviceType])
}

model AssetComponent {
  id               String         @id @default(cuid())
  assetId          String
  deviceProfileId  String?
  type             ComponentType
  slotOrBay        String?
  brand            String?
  model            String?
  serialNumber     String?
  capacity         String?
  storageKind      String?
  source           String         @default("manual")
  sourceObservedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  asset            Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  deviceProfile    DeviceProfile? @relation(fields: [deviceProfileId], references: [id], onDelete: SetNull)

  @@index([assetId, type])
}

model InventoryObservation {
  id           String            @id @default(cuid())
  assetId      String
  source       String
  status       ObservationStatus @default(proposed)
  fields       Json
  observedAt   DateTime          @default(now())
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime          @default(now())
  asset        Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reviewedBy   SystemUser?       @relation("InventoryObservationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([assetId, status])
}

model ComputerIntakeDraft {
  id          String      @id @default(cuid())
  createdById String
  branchId    String?
  status      DraftStatus @default(draft)
  data        Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  submittedAt DateTime?
  submittedAssetId String?
  submitIdempotencyKey String? @unique
  submitPayloadHash String?
  createdBy   SystemUser  @relation(fields: [createdById], references: [id])
  branch      Branch?     @relation(fields: [branchId], references: [id])

  @@index([createdById, status])
  @@index([branchId, status])
}

enum DeviceType {
  computer
  laptop
}

enum ComponentType {
  ram
  storage
}

enum ObservationStatus {
  proposed
  verified
  conflict
  rejected
}

enum DraftStatus {
  draft
  submitted
  cancelled
}

model HardwareScan {
  id               String              @id @default(cuid())
  assetId          String
  submittedById    String
  fileName         String
  rawHtml          String
  parsedSpecs      Json
  isBaseline       Boolean             @default(false)
  comparisonResult Json?
  overallStatus    HwComparisonStatus?
  status           HardwareScanStatus  @default(pending)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime            @default(now())
  asset            Asset               @relation(fields: [assetId], references: [id])
  submittedBy      SystemUser          @relation("HardwareScanSubmitter", fields: [submittedById], references: [id])
  reviewedBy       SystemUser?         @relation("HardwareScanReviewer", fields: [reviewedById], references: [id])

  @@index([assetId, isBaseline])
}

model AssetAssignment {
  id                String           @id @default(cuid())
  assetId           String
  employeeId        String
  status            AssignmentStatus @default(active)
  assignedAt        DateTime         @default(now())
  returnedAt        DateTime?
  notes             String?
  returnNotes       String?
  returnRequestedAt DateTime?
  returnRequestedBy String?
  asset             Asset            @relation(fields: [assetId], references: [id])
  employee          Employee         @relation(fields: [employeeId], references: [id])
}

model MovementLog {
  id         String       @id @default(cuid())
  assetId    String
  employeeId String?
  type       MovementType
  notes      String?
  createdAt  DateTime     @default(now())
  asset      Asset        @relation(fields: [assetId], references: [id])
  employee   Employee?    @relation(fields: [employeeId], references: [id])
}

model ImportHistory {
  id                 String       @id @default(cuid())
  uploadedById       String
  fileName           String
  fileSize           Int
  totalRows          Int          @default(0)
  importedRows       Int          @default(0)
  skippedRows        Int          @default(0)
  failedRows         Int          @default(0)
  duplicatesSkipped  Int          @default(0)
  categoriesCreated  Int          @default(0)
  editedBeforeImport Int          @default(0)
  overwrittenRows    Int          @default(0)
  strictMode         Boolean      @default(false)
  status             ImportStatus @default(pending)
  createdAt          DateTime     @default(now())
  mappingUsed        Json?
  assetsCreated      Int          @default(0)
  assetsDuplicate    Int          @default(0)
  assetsUpdated      Int          @default(0)
  assignmentsCreated Int          @default(0)
  employeesCreated   Int          @default(0)
  employeesUpdated   Int          @default(0)
  assets             Asset[]
  uploadedBy         SystemUser   @relation(fields: [uploadedById], references: [id])
  rows               ImportRow[]

  @@index([uploadedById])
}

model ImportRow {
  id           String        @id @default(cuid())
  importId     String
  rowIndex     Int
  rawData      Json
  mappedData   Json
  outcome      RowOutcome?
  assetId      String?
  errorMessage String?
  isDuplicate  Boolean       @default(false)
  wasEdited    Boolean       @default(false)
  conflictKey  String?
  employeeHint String?
  createdAt    DateTime      @default(now())
  import       ImportHistory @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, rowIndex])
}

model ColumnMappingPreset {
  id           String     @id @default(cuid())
  name         String
  categoryHint String?
  mappings     Json
  isShared     Boolean    @default(false)
  createdById  String
  createdAt    DateTime   @default(now())
  createdBy    SystemUser @relation(fields: [createdById], references: [id])
}

model ScanRoom {
  id         String         @id @default(cuid())
  roomCode   String         @unique
  ownerId    String
  status     ScanRoomStatus @default(open)
  maxDevices Int            @default(5)
  createdAt  DateTime       @default(now())
  expiresAt  DateTime
  devices    ScanDevice[]
  results    ScanResult[]
  owner      SystemUser     @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([expiresAt])
}

model ScanDevice {
  id          String           @id @default(cuid())
  roomId      String
  deviceToken String           @unique
  deviceLabel String
  status      ScanDeviceStatus @default(waiting)
  connectedAt DateTime?
  lastSeenAt  DateTime?
  room        ScanRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  results     ScanResult[]

  @@index([roomId])
}

model ScanResult {
  id           String           @id @default(cuid())
  roomId       String
  deviceId     String
  parsedData   Json
  rawLines     Json
  status       ScanResultStatus @default(pending)
  rejectReason String?
  assetId      String?
  scannedAt    DateTime         @default(now())
  device       ScanDevice       @relation(fields: [deviceId], references: [id])
  room         ScanRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, status])
  @@index([status, scannedAt])
}

enum AssetCondition {
  usable
  for_repair
  for_disposal
}

enum OwnershipType {
  company
  personal
}

enum MovementType {
  assignment
  transfer
  site_transfer
  resignation
  new_hire
  repair_send
  repair_return
  disposal
  lost_report
  stolen_report
  recovery
  return_requested
  return_approved
  return_rejected
}

enum AssignmentStatus {
  active
  returned
  transferred
  pending_return
}

model StockItem {
  id            String             @id @default(cuid())
  sku           String             @unique
  idempotencyKey String              @unique
  requestFingerprint String
  name          String
  category      String
  unitOfMeasure String
  description   String?
  isSerialized  Boolean            @default(false)
  active        Boolean            @default(true)
  archivedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  movements     StockMovement[]
  policies      StockLevelPolicy[]
  countLines    StockCountLine[]
}

model StockLocation {
  id            String              @id @default(cuid())
  branchId      String
  name          String
  locationType  StockLocationType
  description   String?
  archivedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  movements     StockLedgerEntry[]
  policies      StockLevelPolicy[]
  countSessions StockCountSession[]
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, archivedAt])
}

model StockMovement {
  id                String            @id @default(cuid())
  stockItemId       String
  movementType      StockMovementType
  quantity          Decimal           @db.Decimal(18, 3)
  reason            String?
  referenceType     String?
  referenceId       String?
  idempotencyKey    String            @unique
  requestFingerprint String
  performedById     String
  approvedById      String?
  approvedAt        DateTime?
  relatedEmployeeId String?
  relatedAssetId    String?
  createdAt         DateTime          @default(now())
  stockItem         StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  entries           StockLedgerEntry[]
  performedBy       SystemUser        @relation("StockMovementPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)
  approvedBy        SystemUser?       @relation("StockMovementApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  relatedEmployee   Employee?         @relation(fields: [relatedEmployeeId], references: [id], onDelete: SetNull)
  relatedAsset      Asset?            @relation(fields: [relatedAssetId], references: [id], onDelete: SetNull)

  @@index([stockItemId, createdAt])
}

model StockLedgerEntry {
  id            String        @id @default(cuid())
  movementId    String
  locationId    String
  quantityDelta Decimal       @db.Decimal(18, 3)
  createdAt     DateTime      @default(now())
  movement      StockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  location      StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([locationId, createdAt])
}

model StockLevelPolicy {
  id              String        @id @default(cuid())
  stockItemId     String
  locationId      String
  minimumQuantity Decimal       @db.Decimal(18, 3)
  reorderQuantity Decimal       @db.Decimal(18, 3)
  updatedAt       DateTime      @updatedAt
  stockItem       StockItem     @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  location        StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([stockItemId, locationId])
}

model StockCountSession {
  id                        String           @id @default(cuid())
  locationId                String
  status                    StockCountStatus @default(draft)
  startedById               String
  submittedAt               DateTime?
  approvedById              String?
  approvedAt                DateTime?
  expectedUpdatedAt         DateTime         @updatedAt
  idempotencyKey            String           @unique
  approvalIdempotencyKey    String?          @unique
  approvalReason            String?
  approvalExpectedUpdatedAt DateTime?
  location                  StockLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines                     StockCountLine[]
  startedBy                 SystemUser       @relation("StockCountStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  approvedBy                SystemUser?      @relation("StockCountApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
}

model StockCountLine {
  id                       String            @id @default(cuid())
  sessionId                String
  stockItemId              String
  expectedQuantitySnapshot Decimal           @db.Decimal(18, 3)
  countedQuantity          Decimal           @db.Decimal(18, 3)
  variance                 Decimal           @db.Decimal(18, 3)
  session                  StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stockItem                StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@unique([sessionId, stockItemId])
}

enum StockLocationType {
  room
  cabinet
  vehicle
  employee_custody
  other
}

enum StockMovementType {
  receive
  issue
  transfer
  adjustment
  count_correction
  consume
  return
  opening
}

enum StockCountStatus {
  draft
  submitted
  approved
  rejected
  cancelled
}

enum AssetStatus {
  active
  lost
  stolen
}

enum UserStatus {
  active
  inactive
  suspended
}

enum ImportStatus {
  pending
  processing
  completed
  partial
  failed
}

enum RowOutcome {
  imported
  skipped
  failed
  duplicate
  overwritten
}

enum HwComparisonStatus {
  match
  warning
  mismatch
}

enum HardwareScanStatus {
  pending
  reviewed
  flagged
  archived
}

enum ScanRoomStatus {
  open
  closed
  expired
}

enum ScanDeviceStatus {
  waiting
  connected
  scanning
  done
}

enum ScanResultStatus {
  pending
  accepted
  rejected
}

enum RolloutStatus {
  disabled
  staged
  pilot
  enabled
  paused
}

// --- Phase 4: CCTV / NVR inventory foundation ---
// Metadata only. Never stores camera/NVR passwords, stream URLs, footage, or
// exported device configuration. CameraProfile/RecorderChannel intentionally
// omit a network-interface/port linkage in this isolated branch because that
// linkage depends on NetworkInterface/NetworkPort models owned by an
// unmerged networking phase; add it back once that phase lands on main.

model CameraProfile {
  id                     String                    @id @default(cuid())
  assetId                String                    @unique
  physicalLocation       String
  coverageArea           String?
  cameraType             CameraType                @default(fixed)
  resolution             String?
  nightVision            Boolean?
  motionDetection        Boolean?
  installationDate       DateTime?
  notes                  String?
  idempotencyKey         String?                   @unique
  idempotencyPayloadHash String?
  secretReferences       AssetSecretReference[]    @relation("CameraSecretReferences")
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  asset                  Asset                     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignments            CameraChannelAssignment[]

  @@index([physicalLocation])
}

model RecorderProfile {
  id                     String            @id @default(cuid())
  assetId                String            @unique
  recorderType           RecorderType      @default(nvr)
  channelCapacity        Int
  physicalLocation       String
  storageCapacityBytes   BigInt?
  retentionDaysTarget    Int?
  notes                  String?
  idempotencyKey         String?           @unique
  idempotencyPayloadHash String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  asset                  Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  channels               RecorderChannel[]

  @@index([physicalLocation])
}

model RecorderChannel {
  id            String                    @id @default(cuid())
  recorderId    String
  channelNumber Int
  label         String?
  enabled       Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  recorder      RecorderProfile           @relation(fields: [recorderId], references: [id], onDelete: Cascade)
  assignments   CameraChannelAssignment[]

  @@unique([recorderId, channelNumber])
}

model CameraChannelAssignment {
  id                     String          @id @default(cuid())
  cameraId               String
  channelId              String
  validFrom              DateTime        @default(now())
  validTo                DateTime?
  notes                  String?
  idempotencyKey         String?         @unique
  idempotencyPayloadHash String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  camera                 CameraProfile   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  channel                RecorderChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([cameraId, validFrom])
  @@index([channelId, validFrom])
}

model SecretReference {
  id           String                 @id @default(cuid())
  provider     String
  referenceId  String
  displayLabel String?
  system       String?
  ownerTeam    String?
  rotationAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  assets       AssetSecretReference[] @relation("SecretReferenceLinks")

  @@unique([provider, referenceId])
}

model AssetSecretReference {
  id                String          @id @default(cuid())
  assetId           String
  secretReferenceId String
  cameraProfileId   String?
  createdAt         DateTime        @default(now())
  asset             Asset           @relation("AssetSecretReferences", fields: [assetId], references: [id], onDelete: Cascade)
  secretReference   SecretReference @relation("SecretReferenceLinks", fields: [secretReferenceId], references: [id], onDelete: Cascade)
  cameraProfile     CameraProfile?  @relation("CameraSecretReferences", fields: [cameraProfileId], references: [id], onDelete: Cascade)

  @@unique([assetId, secretReferenceId, cameraProfileId])
  @@index([secretReferenceId])
}

enum CameraType {
  fixed
  dome
  bullet
  ptz
  thermal
  other
}

enum RecorderType {
  nvr
  dvr
  hybrid
  other
}
